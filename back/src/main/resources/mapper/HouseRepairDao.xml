<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.HouseRepairDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.HouseRepairEntity" id="houseRepairMap">
        <result property="contractNumber" column="contractNumber"/>
        <result property="houseName" column="houseName"/>
        <result property="houseType" column="houseType"/>
        <result property="community" column="community"/>
        <result property="repairTitle" column="repairTitle"/>
        <result property="repairType" column="repairType"/>
        <result property="repairContent" column="repairContent"/>
        <result property="tupian" column="tupian"/>
        <result property="repairDate" column="repairDate"/>
        <result property="landlordAccount" column="landlordAccount"/>
        <result property="landlordName" column="landlordName"/>
        <result property="tenantUsername" column="tenantUsername"/>
        <result property="contactPhone" column="contactPhone"/>
        <result property="reviewStatus" column="reviewStatus"/>
        <result property="reviewReply" column="reviewReply"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.HouseRepairVO" >
		SELECT * FROM houseRepair  houseRepair         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.HouseRepairVO" >
		SELECT  houseRepair.* FROM houseRepair  houseRepair 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.HouseRepairView" >

		SELECT  houseRepair.* FROM houseRepair  houseRepair 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.HouseRepairView" >
		SELECT * FROM houseRepair  houseRepair <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
</mapper>