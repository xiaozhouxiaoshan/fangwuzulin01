<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.LandlordApplicationCommentDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.LandlordApplicationCommentEntity" id="landlordApplicationCommentMap">
        <result property="referenceId" column="referenceId"/>
        <result property="userId" column="userId"/>
        <result property="content" column="content"/>
        <result property="reply" column="reply"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.LandlordApplicationCommentVO" >
		SELECT * FROM landlordApplicationComment  landlordApplicationComment         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.LandlordApplicationCommentVO" >
		SELECT  landlordApplicationComment.* FROM landlordApplicationComment  landlordApplicationComment 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.LandlordApplicationCommentView" >

		SELECT  landlordApplicationComment.* FROM landlordApplicationComment  landlordApplicationComment 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.LandlordApplicationCommentView" >
		SELECT * FROM landlordApplicationComment  landlordApplicationComment <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
