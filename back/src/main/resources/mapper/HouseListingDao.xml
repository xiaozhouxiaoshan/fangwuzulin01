<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.HouseListingDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.HouseListingEntity" id="houseListingMap">
        <result property="houseName" column="houseName"/>
        <result property="houseType" column="houseType"/>
        <result property="picture" column="picture"/>
        <result property="rentalMode" column="rentalMode"/>
        <result property="orientationFloor" column="orientationFloor"/>
        <result property="area" column="area"/>
        <result property="houseStatus" column="houseStatus"/>
        <result property="community" column="community"/>
        <result property="addressDetail" column="addressDetail"/>
        <result property="monthlyRent" column="monthlyRent"/>
        <result property="deposit" column="deposit"/>
        <result property="facilities" column="facilities"/>
        <result property="houseDescription" column="houseDescription"/>
        <result property="publishDate" column="publishDate"/>
        <result property="landlordAccount" column="landlordAccount"/>
        <result property="landlordName" column="landlordName"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.HouseListingVO" >
		SELECT * FROM houseListing  houseListing         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.HouseListingVO" >
		SELECT  houseListing.* FROM houseListing  houseListing 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.HouseListingView" >

		SELECT  houseListing.* FROM houseListing  houseListing 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.HouseListingView" >
		SELECT * FROM houseListing  houseListing <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
</mapper>