<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.ViewingAppointmentDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.ViewingAppointmentEntity" id="viewingAppointmentMap">
        <result property="appointmentNumber" column="appointmentNumber"/>
        <result property="houseName" column="houseName"/>
        <result property="houseType" column="houseType"/>
        <result property="houseStatus" column="houseStatus"/>
        <result property="community" column="community"/>
        <result property="monthlyRent" column="monthlyRent"/>
        <result property="deposit" column="deposit"/>
        <result property="rentalMonths" column="rentalMonths"/>
        <result property="rentalAmount" column="rentalAmount"/>
        <result property="appointmentTime" column="appointmentTime"/>
        <result property="tenantUsername" column="tenantUsername"/>
        <result property="fullName" column="fullName"/>
        <result property="idCardNumber" column="idCardNumber"/>
        <result property="contactPhone" column="contactPhone"/>
        <result property="landlordAccount" column="landlordAccount"/>
        <result property="landlordName" column="landlordName"/>
        <result property="reviewStatus" column="reviewStatus"/>
        <result property="reviewReply" column="reviewReply"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.ViewingAppointmentVO" >
		SELECT * FROM viewingAppointment  viewingAppointment         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.ViewingAppointmentVO" >
		SELECT  viewingAppointment.* FROM viewingAppointment  viewingAppointment 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.ViewingAppointmentView" >

		SELECT  viewingAppointment.* FROM viewingAppointment  viewingAppointment 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.ViewingAppointmentView" >
		SELECT * FROM viewingAppointment  viewingAppointment <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
</mapper>