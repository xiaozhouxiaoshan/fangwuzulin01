<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.RepairHandlingDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.RepairHandlingEntity" id="repairHandlingMap">
        <result property="fangwumingcheng" column="fangwumingcheng"/>
        <result property="houseType" column="houseType"/>
        <result property="baoxiumingcheng" column="baoxiumingcheng"/>
        <result property="leixing" column="leixing"/>
        <result property="baoxiuriqi" column="baoxiuriqi"/>
        <result property="weixiufankui" column="weixiufankui"/>
        <result property="weixiujindu" column="weixiujindu"/>
        <result property="gengxinriqi" column="gengxinriqi"/>
        <result property="landlordzhanghao" column="landlordzhanghao"/>
        <result property="landlordxingming" column="landlordxingming"/>
        <result property="tenantming" column="tenantming"/>
        <result property="lianxidianhua" column="lianxidianhua"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.RepairHandlingVO" >
		SELECT * FROM repairHandling  repairHandling         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.RepairHandlingVO" >
		SELECT  repairHandling.* FROM repairHandling  repairHandling 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.RepairHandlingView" >

		SELECT  repairHandling.* FROM repairHandling  repairHandling 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.RepairHandlingView" >
		SELECT * FROM repairHandling  repairHandling <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
</mapper>