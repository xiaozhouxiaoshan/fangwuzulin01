<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.RepairHandlingDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.RepairHandlingEntity" id="repairHandlingMap">
        <result property="houseName" column="houseName"/>
        <result property="houseType" column="houseType"/>
        <result property="repairTitle" column="repairTitle"/>
        <result property="repairType" column="repairType"/>
        <result property="repairDate" column="repairDate"/>
        <result property="handlingFeedback" column="handlingFeedback"/>
        <result property="handlingProgress" column="handlingProgress"/>
        <result property="updatedDate" column="updatedDate"/>
        <result property="landlordAccount" column="landlordAccount"/>
        <result property="landlordName" column="landlordName"/>
        <result property="tenantUsername" column="tenantUsername"/>
        <result property="contactPhone" column="contactPhone"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.RepairHandlingVO" >
		SELECT * FROM repairHandling  repairHandling         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.RepairHandlingVO" >
		SELECT  repairHandling.* FROM repairHandling  repairHandling 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.RepairHandlingView" >

		SELECT  repairHandling.* FROM repairHandling  repairHandling 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.RepairHandlingView" >
		SELECT * FROM repairHandling  repairHandling <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
</mapper>