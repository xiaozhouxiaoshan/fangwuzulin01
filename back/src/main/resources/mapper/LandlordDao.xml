<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.LandlordDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.LandlordEntity" id="landlordMap">
        <result property="landlordAccount" column="landlordAccount"/>
        <result property="password" column="password"/>
        <result property="landlordName" column="landlordName"/>
        <result property="gender" column="gender"/>
        <result property="avatar" column="avatar"/>
        <result property="phoneNumber" column="phoneNumber"/>
        <result property="idCardNumber" column="idCardNumber"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.LandlordVO" >
		SELECT * FROM landlord  landlord         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.LandlordVO" >
		SELECT  landlord.* FROM landlord  landlord 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.LandlordView" >

		SELECT  landlord.* FROM landlord  landlord 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.LandlordView" >
		SELECT * FROM landlord  landlord <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
</mapper>