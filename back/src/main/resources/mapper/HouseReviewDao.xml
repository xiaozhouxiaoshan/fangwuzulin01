<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.HouseReviewDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.HouseReviewEntity" id="houseReviewMap">
        <result property="contractNumber" column="contractNumber"/>
        <result property="houseName" column="houseName"/>
        <result property="houseType" column="houseType"/>
        <result property="community" column="community"/>
        <result property="rating" column="rating"/>
        <result property="reviewContent" column="reviewContent"/>
        <result property="reviewDate" column="reviewDate"/>
        <result property="landlordAccount" column="landlordAccount"/>
        <result property="tenantUsername" column="tenantUsername"/>
        <result property="contactPhone" column="contactPhone"/>
        <result property="reviewStatus" column="reviewStatus"/>
        <result property="reviewReply" column="reviewReply"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.HouseReviewVO" >
		SELECT * FROM houseReview  houseReview         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.HouseReviewVO" >
		SELECT  houseReview.* FROM houseReview  houseReview 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.HouseReviewView" >

		SELECT  houseReview.* FROM houseReview  houseReview 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.HouseReviewView" >
		SELECT * FROM houseReview  houseReview <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
</mapper>