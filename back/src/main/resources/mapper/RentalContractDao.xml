<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.RentalContractDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.RentalContractEntity" id="rentalContractMap">
        <result property="contractNumber" column="contractNumber"/>
        <result property="houseName" column="houseName"/>
        <result property="houseType" column="houseType"/>
        <result property="community" column="community"/>
        <result property="monthlyRent" column="monthlyRent"/>
        <result property="rentalMonths" column="rentalMonths"/>
        <result property="rentalAmount" column="rentalAmount"/>
        <result property="deposit" column="deposit"/>
        <result property="rentalStatus" column="rentalStatus"/>
        <result property="contractAmount" column="contractAmount"/>
        <result property="contractContent" column="contractContent"/>
        <result property="effectiveDate" column="effectiveDate"/>
        <result property="expiryDate" column="expiryDate"/>
        <result property="tenantUsername" column="tenantUsername"/>
        <result property="contactPhone" column="contactPhone"/>
        <result property="landlordAccount" column="landlordAccount"/>
        <result property="landlordName" column="landlordName"/>
        <result property="reviewStatus" column="reviewStatus"/>
        <result property="reviewReply" column="reviewReply"/>
        <result property="paymentStatus" column="paymentStatus"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.RentalContractVO" >
		SELECT * FROM rentalContract  rentalContract         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.RentalContractVO" >
		SELECT  rentalContract.* FROM rentalContract  rentalContract 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.RentalContractView" >

		SELECT  rentalContract.* FROM rentalContract  rentalContract 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.RentalContractView" >
		SELECT * FROM rentalContract  rentalContract <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
</mapper>