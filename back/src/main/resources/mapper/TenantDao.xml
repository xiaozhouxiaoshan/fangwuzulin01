<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.TenantDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.TenantEntity" id="tenantMap">
        <result property="tenantming" column="tenantming"/>
        <result property="mima" column="mima"/>
        <result property="xingming" column="xingming"/>
        <result property="touxiang" column="touxiang"/>
        <result property="xingbie" column="xingbie"/>
        <result property="zhiye" column="zhiye"/>
        <result property="lianxidianhua" column="lianxidianhua"/>
        <result property="shenfenzheng" column="shenfenzheng"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.TenantVO" >
		SELECT * FROM tenant  tenant         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.TenantVO" >
		SELECT  tenant.* FROM tenant  tenant 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.TenantView" >

		SELECT  tenant.* FROM tenant  tenant 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.TenantView" >
		SELECT * FROM tenant  tenant <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
</mapper>