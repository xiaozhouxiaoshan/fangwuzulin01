<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.TenantDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.TenantEntity" id="tenantMap">
        <result property="tenantUsername" column="tenantUsername"/>
        <result property="password" column="password"/>
        <result property="fullName" column="fullName"/>
        <result property="avatar" column="avatar"/>
        <result property="gender" column="gender"/>
        <result property="occupation" column="occupation"/>
        <result property="contactPhone" column="contactPhone"/>
        <result property="idCardNumber" column="idCardNumber"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.TenantVO" >
		SELECT * FROM tenant  tenant         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.TenantVO" >
		SELECT  tenant.* FROM tenant  tenant 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.TenantView" >

		SELECT  tenant.* FROM tenant  tenant 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.TenantView" >
		SELECT * FROM tenant  tenant <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
</mapper>